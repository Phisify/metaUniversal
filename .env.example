ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=meta-engine

# Instagram API with Instagram Login (professional account).
# The long-lived token seeds Supabase once, then refreshes itself every Monday.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_VERSION=v26.0

# Free key from pixabay.com/api/docs (log in, key shown under "Parameters"), used for generic scene photos
PIXABAY_API_KEY=

TIMEZONE=Europe/London
POST_TIMES=08:30,13:30,19:30

# Keep true until the dry-run output looks right, then flip to false
DRY_RUN=true
CONTACT_EMAIL=info@phisify.com

# ---------------- Cross-posting (each one switches on once its keys are filled in)
CHANNELS=ig_story,threads,x,linkedin

# Threads: same Meta app, add the "Access the Threads API" use case
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_API_BASE=https://graph.threads.net/v1.0

# X: developer.x.com app with Read and Write, keys generated while logged in as the Phisify X account
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_MAX_CHARS=280

# LinkedIn: company page needs the Community Management API product approved on your LinkedIn app
LINKEDIN_AUTHOR=urn:li:organization:
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_VERSION=202606
