ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=meta-engine

# Instagram API with Instagram Login (professional account).
# The long-lived token seeds Supabase once, then refreshes itself every Monday.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_VERSION=v26.0

# Free key from pixabay.com/api/docs (log in, key shown under "Parameters"), used for generic scene photos
PIXABAY_API_KEY=

TIMEZONE=Europe/London
POST_TIMES=08:30,13:30,19:30

# Keep true until the dry-run output looks right, then flip to false
DRY_RUN=true
CONTACT_EMAIL=info@phisify.com
